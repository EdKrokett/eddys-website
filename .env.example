# Basis-URL der WordPress-Instanz (öffentliche, unauthentifizierte REST-API).
# Override nur nötig, falls z.B. ein Staging-WP-Klon angebunden wird.
NUXT_PUBLIC_WORDPRESS_URL=https://blog.eduard-andrae.de

# Shared Secret für den WordPress-Kommentar-Webhook (server/api/revalidate-comments.post.ts).
# Muss identisch im WP-Plugin unter Einstellungen → Kommentar-Webhook stehen.
# Leer oder fehlend = der Endpunkt weist jede Anfrage ab.
NUXT_REVALIDATE_SECRET=<geheim>

# Token, mit dem Vercel eine ISR-Seite auf Zuruf neu baut (Header x-prerender-revalidate).
# Wird ZUR BUILD-ZEIT in nitro.vercel.config.bypassToken eingesetzt — in Vercel also auch
# für den Build setzen, nicht nur zur Laufzeit. Erzeugen: openssl rand -base64 32
VERCEL_BYPASS_TOKEN=<geheim>
